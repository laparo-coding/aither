# =============================================================================
# Aither — Hemera Academy API Integration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# IMPORTANT: Values like __REQUIRED__, __DO_NOT_COMMIT_REAL_KEY__ or
# __REQUIRED_GENERATE_FRESH_SECRET__ are PLACEHOLDERS. The app validates its
# environment at startup and REFUSES TO START while any variable still
# contains a placeholder — replace every one of them with a real value.
# =============================================================================

# --- Hemera Academy API ---
# Base URL of the Hemera API (full origin, e.g. https://hemera-academy.vercel.app).
# The client appends /api/service/* paths automatically — do NOT include a path suffix.
HEMERA_API_BASE_URL=https://hemera-academy.vercel.app

# API Key for Hemera service API authentication (M2M).
# This is the client-side copy of the shared secret. It is sent as the
# X-API-Key header to hemera's /api/service/* endpoints.
# On hemera's side the same value must be stored as HEMERA_SERVICE_API_KEY.
# Both variables must contain the exact same Base64url-encoded string (min 32 bytes).
#
# Generate a compliant key:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
# Rotate keys regularly and store them in your secret manager (Vercel/AWS/GCP).
HEMERA_API_KEY=__REQUIRED__

# --- Clerk Authentication ---
# Obtain these from your Clerk Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=__REQUIRED__
CLERK_SECRET_KEY=__REQUIRED__

# Service User Configuration
# Purpose: Dedicated Clerk user for service-to-service API authentication
# Security Posture:
#   - Limited permissions: api-client role (read courses, update participation results only)
#   - Cannot access admin functions or user management
#   - Tokens are short-lived (15 minutes) and cached with automatic refresh
#   - Principle of least privilege: only the minimum required scopes
# Setup:
#   1. Create a service user in Clerk Dashboard
#   2. Set publicMetadata: { "role": "api-client", "service": "aither" }
#   3. Copy the user ID to CLERK_SERVICE_USER_ID
# Security Best Practices:
#   - Rotate service user credentials every 90 days
#   - Monitor usage logs for suspicious activity
#   - Restrict scopes to only required permissions
#   - Use separate service users for dev/staging/production
# WARNING: Never commit real values to version control. Use .env.local for actual credentials.
CLERK_SERVICE_USER_ID=__REQUIRED__
CLERK_SERVICE_USER_EMAIL=__REQUIRED__

# Note: The Clerk service user (CLERK_SERVICE_USER_ID/CLERK_SERVICE_USER_EMAIL) is used for
# internal Clerk authentication. The HEMERA_API_KEY is a static API key for external
# Hemera API calls (sent as X-API-Key header). These are separate credentials.

# --- SMTP Notifications ---
SMTP_HOST=__REQUIRED__
SMTP_PORT=587
SMTP_USER=__REQUIRED__
SMTP_PASS=__REQUIRED__
SMTP_FROM=__REQUIRED__
NOTIFY_EMAIL_TO=__REQUIRED__
NOTIFY_FAILURE_THRESHOLD=3

# --- Rollbar Error Monitoring ---
# Obtain these from your Rollbar Dashboard: https://rollbar.com
ROLLBAR_SERVER_TOKEN=__REQUIRED__
NEXT_PUBLIC_ROLLBAR_CLIENT_TOKEN=__REQUIRED__

# --- Rollbar MCP Server (prefer Read-Only token for automation) ---
# For most integrations use a Read-Only project token. If write access is
# explicitly required for a workflow, configure a separate write-only token.
ROLLBAR_ACCESS_TOKEN_READONLY=__REQUIRED__
# Optional: only set this if you really need write access for tooling
# ROLLBAR_ACCESS_TOKEN=__REQUIRED__

# --- Rollbar Control Flags ---
# `ROLLBAR_ENABLED` controls the server-side SDK.
# `NEXT_PUBLIC_ROLLBAR_ENABLED` controls only the public browser bundle.
# A server-only local setup can keep the browser flag at 0.
NEXT_PUBLIC_ROLLBAR_ENABLED=0
ROLLBAR_ENABLED=1

# --- Rollbar Sampling Rates (0.0–1.0) ---
# ROLLBAR_SAMPLE_RATE_ALL=1
# ROLLBAR_SAMPLE_RATE_INFO=0.05
# ROLLBAR_SAMPLE_RATE_WARN=0.05
# ROLLBAR_SAMPLE_RATE_ERROR=1
# ROLLBAR_SAMPLE_RATE_CRITICAL=1

# --- Privacy / PII ---
# Set to 1 to allow userId/email in error reports
# NEXT_PUBLIC_TELEMETRY_CONSENT=0
# ROLLBAR_ALLOW_PII=0

# --- E2E Testing ---
# E2E_TEST=0

# --- Postman MCP ---
# Obtain from: https://www.postman.com/settings/api-keys
POSTMAN_API_KEY=__REQUIRED__

# --- Output Directory ---
HTML_OUTPUT_DIR=output

# =============================================================================
# Video Transcription (Feature 012)
# =============================================================================
# AssemblyAI transcription, MUX signed playback, and private Vercel Blob
# staging/transcript configuration. All values below are server-only.
# Production (Linux/systemd): secrets arrive through a root-owned,
# permission-restricted systemd EnvironmentFile= outside the repository.
# NEVER commit real credential values to version control.
# =============================================================================

# --- AssemblyAI API ---
# Server-only API endpoint enabled for the active account's Free plan.
# MUST be confirmed against the account before deployment; Aither performs
# NO automatic region fallback. Example: https://api.assemblyai.com
ASSEMBLY_AI_BASE_URL=REPLACE_WITH_YOUR_ASSEMBLY_AI_ENDPOINT

# Local development (macOS): .env.local stores ONLY the Keychain service
# reference — never the plaintext key. The server resolves the actual key
# via the macOS `security` CLI at startup.
# Example value: assemblyai-aither-api-key
ASSEMBLY_AI_API_KEY_KEYCHAIN_SERVICE=assemblyai-aither-api-key

# Production (Linux/systemd): the plaintext key is provided by the host's
# protected EnvironmentFile= (root-owned, 0600). Do NOT set this on macOS.
# ASSEMBLY_AI_API_KEY=your-production-assemblyai-key

# --- AssemblyAI Webhook ---
# Independent secret used to authenticate AssemblyAI completion callbacks
# (sent as X-AssemblyAI-Webhook-Secret header). Must be reachable over HTTPS.
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ASSEMBLY_AI_WEBHOOK_SECRET=__REQUIRED_GENERATE_FRESH_SECRET__

# --- MUX Signed Playback ---
# Signing key for generating short-lived playback JWTs. The JWT expiry MUST
# exceed the full video duration. New seminar assets use signed playback policy.
# Obtain from MUX Dashboard → Settings > Signing Keys.
MUX_SIGNING_KEY_ID=__REQUIRED__
# PEM-formatted private key (-----BEGIN PRIVATE KEY-----).
# NEVER commit a real key. Generate a new keypair in the MUX Dashboard.
MUX_SIGNING_KEY_PRIVATE_KEY=__DO_NOT_COMMIT_REAL_KEY__

# --- Vercel Blob (private storage) ---
# Existing Blob token for private source staging and final transcript objects.
# Staging objects are never participant-visible; transcript signed GET URLs
# expire after exactly 5 minutes.
# Generate via Vercel Dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=__REQUIRED_VERCEL_BLOB_TOKEN__

# --- Gaia -> Aither Sync Trigger (optional local M2M auth) ---
# Exact bearer token accepted by POST/GET /api/sync for service-to-service triggering.
# Generate a long random token for local/staging use and keep it out of version control.
# Example: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AITHER_SYNC_TOKEN=__REQUIRED_GENERATE_FRESH_SECRET__

# --- Vercel Blob Storage (Spec 009 — ffmetadata sidecar) ---
# Dedicated Aither Blob store token (separate from Hemera's).
# Required at request time for POST /api/recording/timestamp; missing → 503.
# Falls back to BLOB_READ_WRITE_TOKEN when unset (backward compatibility).
# Format: vercel_blob_rw_...
# Generate via the Vercel dashboard → Aither project → Storage → Blob.
BLOB_READ_WRITE_TIMESTAMP_TOKEN=__REQUIRED_VERCEL_BLOB_TOKEN__

# --- Uranos Service Token (Spec 009 — timestamp endpoint auth) ---
# Shared secret for the Uranos app to authenticate POST /api/recording/timestamp.
# Compared timing-safely; admin Clerk sessions bypass this as a fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
URANOS_SYNC_TOKEN=__REQUIRED_GENERATE_FRESH_SECRET__

# --- Context7 (Documentation MCP) ---
# API key for Context7 (use a secret key in the format ctx7sk_...)
# Set this value in your local `.env` (never commit real keys into the repo)
# Obtain from: https://context7.com
CONTEXT7_API_KEY=__REQUIRED_CONTEXT7_KEY__
