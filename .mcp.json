{
	"mcpServers": {
		"codacy": {
			"type": "local",
			"command": "bash",
			"args": [".vscode/codacy-mcp.sh"],
			"tools": ["*"]
		},
		"context7": {
			"type": "local",
			"command": "bash",
			"args": [".vscode/context7-mcp.sh"],
			"tools": ["*"]
		},
		"playwright": {
			"type": "local",
			"command": "npx",
			"args": ["@playwright/mcp@latest"],
			"tools": ["*"]
		},
		"rollbar": {
			"type": "local",
			"command": "npx",
			"args": ["-y", "@rollbar/mcp-server@latest"],
			"env": {
				"ROLLBAR_CONFIG_FILE": ".rollbar-mcp.json"
			},
			"tools": ["*"]
		},
		"clerk": {
			"type": "http",
			"url": "https://mcp.clerk.com/mcp",
			"tools": ["*"]
		}
	}
}
